# The pipeline worker: the backend code plus the scanner tools it runs (Phase 5). Every tool is
# pinned to an exact version so a scan behaves the same on every machine. The api keeps the slim
# backend/Dockerfile; only the worker carries the scanners.
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH"

# --- Scanner tools (one block per adapter) -------------------------------------------------

# Nmap: port and service discovery. The worker runs as a normal user, so the adapter uses a TCP
# connect scan (-sT), which needs no root privileges or raw sockets.
RUN apt-get update \
 && apt-get install -y --no-install-recommends nmap=7.95+dfsg-3 \
 && rm -rf /var/lib/apt/lists/*

# testssl.sh: TLS/SSL configuration checks (protocols, ciphers, certificate, known flaws).
RUN apt-get update \
 && apt-get install -y --no-install-recommends testssl.sh=3.2.1+dfsg-1 \
 && rm -rf /var/lib/apt/lists/*

# Nuclei: template-based checks for known vulnerabilities and misconfigurations. The binary and
# the template set are pinned and checksum-verified, and scans never update them, so a scan only
# ever runs these exact templates.
ARG TARGETARCH
ARG NUCLEI_VERSION=3.11.1
ARG NUCLEI_TEMPLATES_VERSION=10.5.1
RUN set -e \
 && case "$TARGETARCH" in \
      amd64) nuclei_sha=ea63d4ae232808cd7c6bc00d0142428e231fab59dae01042246097d195835ab6 ;; \
      arm64) nuclei_sha=8044e3d9768ba0a744b2872c1a87e813006f013da97ca9f50f7661a4203bec07 ;; \
      *) echo "no pinned nuclei build for $TARGETARCH" >&2; exit 1 ;; \
    esac \
 && apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl unzip \
 && curl -fsSL -o /tmp/nuclei.zip \
      "https://github.com/projectdiscovery/nuclei/releases/download/v${NUCLEI_VERSION}/nuclei_${NUCLEI_VERSION}_linux_${TARGETARCH}.zip" \
 && echo "${nuclei_sha}  /tmp/nuclei.zip" | sha256sum -c - \
 && unzip -q /tmp/nuclei.zip nuclei -d /usr/local/bin \
 && curl -fsSL -o /tmp/templates.tar.gz \
      "https://github.com/projectdiscovery/nuclei-templates/archive/refs/tags/v${NUCLEI_TEMPLATES_VERSION}.tar.gz" \
 && echo "30fe1cfaced4635f886e4a2673641bba86998dceec28e468274524e789aa56eb  /tmp/templates.tar.gz" | sha256sum -c - \
 && mkdir -p /opt/nuclei-templates \
 && tar -xzf /tmp/templates.tar.gz -C /opt/nuclei-templates --strip-components=1 \
 && apt-get purge -y unzip \
 && rm -rf /tmp/nuclei.zip /tmp/templates.tar.gz /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

COPY . .

RUN useradd --create-home --uid 1000 app
USER app

# Migrations belong to the api, so the worker has no migration entrypoint.
CMD ["python", "-m", "app.workers.worker"]
