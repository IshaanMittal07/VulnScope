# Copy to .env and change the values. Never commit .env.
APP_ENV=development

# PostgreSQL
POSTGRES_USER=vulnscope
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vulnscope

# Only lets the local lab targets (Juice Shop, DVWA) skip ownership verification.
LAB_MODE=true

# Pipeline: how long each Phase 3 stub stage waits, so polling a scan shows every state.
# PIPELINE_STEP_DELAY_SECONDS=1

# Later phases
# NVD_API_KEY=
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen2.5:7b
