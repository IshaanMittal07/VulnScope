# Copy to .env and change the values. Never commit .env.
APP_ENV=development

# PostgreSQL
POSTGRES_USER=vulnscope
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vulnscope

# Only lets the local lab targets (Juice Shop, DVWA) skip ownership verification.
LAB_MODE=true

