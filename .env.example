# Copy to .env and change the values. Never commit .env.
APP_ENV=development

# PostgreSQL
POSTGRES_USER=vulnscope
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vulnscope

# Lets the lab targets (juice-shop, dvwa; see `make lab`) be verified without a token. Defaults to
# false when unset; never enable it on a deployment that scans real targets.
LAB_MODE=true

# Pipeline: how long each Phase 3 stub stage waits, so polling a scan shows every state.
# PIPELINE_STEP_DELAY_SECONDS=1

# Later phases
# NVD_API_KEY=
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen2.5:7b
